+  align-items: center;
+}
+
+.nabd-event strong,
+.nabd-score strong {
+  min-width: 0;
+  overflow: hidden;
+  color: #fff;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.nabd-event span,
+.nabd-score span,
+.nabd-score b {
+  color: #7dd3fc;
+  font-size: 12px;
+  font-weight: 800;
+}
+
+.nabd-event p,
+.nabd-live-box p {
+  margin: 8px 0 0;
+  color: #cbd5e1;
+  line-height: 1.7;
+}
+
+.nabd-score {
+  grid-template-columns: 32px minmax(0, 1fr) auto;
+}
+
+.nabd-live-box {
+  display: grid;
+  gap: 10px;
+  border: 1px solid rgba(56, 189, 248, 0.24);
+}
+
+.nabd-live-box.success {
+  margin-top: 12px;
+  border-color: rgba(34, 197, 94, 0.35);
+  background: rgba(20, 83, 45, 0.46);
+}
+
+.nabd-empty {
+  margin: 0;
+  padding: 34px 10px;
+  text-align: center;
+}
+
+.nabd-raw {
+  max-height: 300px;
+  overflow: auto;
+  border-radius: 12px;
+  background: #020617;
+  color: #d1d5db;
+  direction: ltr;
+  font-size: 12px;
+  line-height: 1.6;
+  padding: 12px;
+  white-space: pre-wrap;
+  word-break: break-all;
+}
+
+@media (max-width: 900px) {
+  .nabd-hero,
+  .nabd-panel-title {
+    align-items: stretch;
+    flex-direction: column;
+  }
+
+  .nabd-grid,
+  .nabd-counters,
+  .nabd-form-grid.poll {
+    grid-template-columns: 1fr;
+  }
+}
+</style>
