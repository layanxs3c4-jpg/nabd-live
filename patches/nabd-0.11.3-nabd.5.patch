+function normalizeViewerScores(value: unknown): TikFinityViewerScore[] {
+  if (!Array.isArray(value))
+    return []
+
+  return value
+    .filter((score): score is TikFinityViewerScore => {
+      if (!score || typeof score !== 'object')
+        return false
+      const candidate = score as Partial<TikFinityViewerScore>
+      return typeof candidate.userId === 'string'
+        && typeof candidate.displayName === 'string'
+        && typeof candidate.points === 'number'
+    })
+    .map(score => ({
+      ...score,
+      lastInteractionAt: typeof score.lastInteractionAt === 'number' ? score.lastInteractionAt : 0,
+    }))
+}
